DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/postgres?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required once to enable the first admin gÃ©nÃ©ral setup. Remove after setup.
INITIAL_SETUP_TOKEN=""
CRON_SECRET=""

# Local simulator is used only when no SasPay API key is configured.
PAYMENT_MODE="mock"

# Add the API key from SasPay's developer dashboard; this activates real checkout.
SASPAY_API_KEY=""
# Configure after creating the webhook in SasPay's dashboard; do not share this secret.
SASPAY_WEBHOOK_SECRET=""
# Gmail SMTP: create a Google App Password and keep it only in the ignored local .env
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Public HTTPS origin in production; used to build verification and recovery links.
APP_URL="http://localhost:3000"

# Persistent server-side media directory (JPEG/PNG/GIF/WebP, MP4/WebM; 20 MB max).
MEDIA_UPLOAD_DIR=".local-data/uploads"
# Local-only Vercel Blob token used by the one-time media migration script.
# Production should connect a private Blob store to the Vercel project instead.
BLOB_READ_WRITE_TOKEN=""
# One-time, unpooled Neon URL for importing the local database.
# Store this only in the ignored .env.migration.local file, never in Vercel or Git.
NEON_DIRECT_URL=""

# Optional seed account for local development.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Demo Admin"
SEED_TENANT_HANDLE="xpro-demo"

# Optional production object storage provider settings (not wired in this phase).
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
